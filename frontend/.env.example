# URL backend untuk proxy /api. Dipakai saat build, tanpa akhiran /api.
# Lokal: http://127.0.0.1:3001
# Produksi: origin backend Railway/Render, misalnya https://backend-production.up.railway.app
BACKEND_URL=http://127.0.0.1:3001

# Opsional. Kosongkan agar frontend memakai proxy /api (disarankan).
# Isi dengan origin backend tanpa /api hanya jika ingin memanggil backend langsung.
# NEXT_PUBLIC_API_URL=
